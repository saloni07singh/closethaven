# Keep API credentials out of source code and GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local development settings. Use a unique random secret in production.
FLASK_SECRET_KEY=replace-with-a-long-random-string
FLASK_DEBUG=false
APP_ENV=development
ACCESS_PASSWORD=
HOST=127.0.0.1
PORT=5000
